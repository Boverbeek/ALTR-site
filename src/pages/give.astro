---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Give" description="Support ALTR's ongoing work.">
  <section class="pt-40 pb-28 px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow reveal mt-6">Give</p>
      <h1 class="reveal mt-4 font-display text-5xl md:text-6xl text-[color:var(--color-paper)]">
        Give to what God is doing
      </h1>
      <p class="reveal mt-6 text-lg text-[color:var(--color-muted)]">
        Help support what God is doing through generosity. 
        ALTR is partnered with Stony Brook church. All donations 
        are used for the causes and missions happening both in ALTR
        and Stony Brook church.
      </p>
      <div class="reveal mt-10">
        <!-- Swap this href for your giving platform (Tithe.ly, Pushpay, Stripe, etc.) -->
        <a href="https://stonybrookchurch.churchcenter.com/giving" target="_blank" rel="noopener noreferrer" class="btn-ember">Give to ALTR</a>
      </div>
    </div>
  </section>
</Layout>
