---
interface Props {
  class?: string;
  iconClass?: string;
}
const { class: className = "", iconClass = "w-[18px] h-[18px]" } = Astro.props as Props;

const socials = [
  {
    name: "Instagram",
    href: "https://instagram.com/",
    path: "M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.5a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11Zm0 2a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Zm5.75-1.75a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z",
  },
  {
    name: "TikTok",
    href: "https://tiktok.com/",
    path: "M14 2h3.2c.2 1.7 1.4 3.1 3.1 3.5V9c-1.4 0-2.7-.4-3.8-1.1v6.9a6.3 6.3 0 1 1-6.3-6.3c.3 0 .6 0 .9.1v3.3a3 3 0 1 0 2.1 2.9V2Z",
  },
  {
    name: "Facebook",
    href: "https://facebook.com/",
    path: "M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z",
  },
  {
    name: "YouTube",
    href: "https://youtube.com/",
    path: "M21.6 7.6a3 3 0 0 0-2.1-2.1C17.7 5 12 5 12 5s-5.7 0-7.5.5A3 3 0 0 0 2.4 7.6 31 31 0 0 0 2 12a31 31 0 0 0 .4 4.4 3 3 0 0 0 2.1 2.1c1.8.5 7.5.5 7.5.5s5.7 0 7.5-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 22 12a31 31 0 0 0-.4-4.4ZM10 15V9l5.2 3-5.2 3Z",
  },
  {
    name: "Twitch",
    href: "https://twitch.tv/",
    path: "M4 2 2 6.5v13H7V22l3.5-2.5H14L20.5 13V2H4Zm14.5 10-3 3h-3l-2.5 2.5V15H6V4h12.5v8ZM15 7h1.8v5H15V7Zm-4.8 0h1.8v5h-1.8V7Z",
  },
];
---

<div class={`flex items-center gap-4 ${className}`}>
  {socials.map((s) => (
    <a
      href={s.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={s.name}
      class="text-[color:var(--color-muted)] transition-colors hover:text-[color:var(--color-ember-soft)]"
    >
      <svg viewBox="0 0 24 24" class={iconClass} fill="currentColor"><path d={s.path}></path></svg>
    </a>
  ))}
</div>
